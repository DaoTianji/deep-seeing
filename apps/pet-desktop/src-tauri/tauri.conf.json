{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notes",
  "version": "0.1.0",
  "identifier": "tv.yc345.deepseeing.notes",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:3319/pet"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Notes",
        "url": "http://127.0.0.1:3319/pet",
        "width": 72,
        "height": 72,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
