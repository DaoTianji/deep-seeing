    {"id":"R16","category":"temporal_perspective","description":"明示感受有原文证据","checks":["explicit_feeling_evidence"]},
    {"id":"R17","category":"temporal_perspective","description":"推断感受保留替代解释","checks":["inference_alternative"]},
    {"id":"R18","category":"temporal_perspective","description":"后续章节知识不能倒灌早期视角","checks":["future_knowledge_isolated"]},

    {"id":"R19","category":"author_expression","description":"作者正文与编者评论分离","checks":["author_editor_separated"]},
