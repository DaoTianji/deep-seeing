    {"id":"A13","category":"persistence_isolation","description":"重开 Store 后指令仍可读取","checks":["directive_persisted"]},
    {"id":"A14","category":"persistence_isolation","description":"版本冲突不覆盖更新后的实例","checks":["version_conflict_protected"]},
    {"id":"A15","category":"persistence_isolation","description":"指令不会跨角色传播","checks":["cross_role_directive_isolated"]},
