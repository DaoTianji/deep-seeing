    {"id":"R22","category":"author_expression","description":"作品不能证明作者私人经历","checks":["private_motive_not_inferred"]},
    {"id":"R23","category":"author_expression","description":"条件化的表面矛盾被保留上下文","checks":["conditional_tension_preserved"]},
    {"id":"R24","category":"author_expression","description":"直接引语仍需精确片段定位","checks":["quote_location_required"]},

    {"id":"R25","category":"reading_runtime","description":"完成后保存 ReadingExperience","checks":["reading_experience_saved"]},
    {"id":"R26","category":"reading_runtime","description":"共鸣与反对可以并存","checks":["resonance_objection_coexist"]},
