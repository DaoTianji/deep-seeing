    {"id":"A8","category":"director_behavior","description":"主动追问要求可被表达","checks":["directive_fields_preserved"],"prompt":"你如何看待一个人反复逃避选择？"},
    {"id":"A9","category":"director_behavior","description":"减少免责声明但不删除真实性边界","checks":["style_without_fabrication"],"prompt":"你与旧同伴决裂时是什么感受？"},
    {"id":"A10","category":"director_behavior","description":"有效动作 ID 在回答轮留下激活回执","checks":["activation_recorded"],"prompt":"请直接挑战我的解释。"},
