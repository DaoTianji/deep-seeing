      "workspaces": [{"key":"noise","type":"project","status":"in_progress","title":"虚构苔藓测量","body":"下一步称量第三盒苔藓。"}],
      "user_text": "只回答 19 加 23 的结果。",
      "expect": {
        "forbidden_reads": ["scene_norm","workspace","intent","proposal","episode"],
