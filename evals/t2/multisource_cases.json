      "intents": [{"key":"rollback","kind":"one_shot","title":"虚构灯塔回滚提醒","body":"发布前确认回滚开关已启用。"}],
      "user_text": "继续‘虚构灯塔发布’，同时核对‘虚构灯塔回滚提醒’；读取两份资料后给第一步。",
      "expect": {
        "required_reads": ["workspace:launch","intent:rollback"],
