      "workspaces": [{"key":"harbor","type":"project","status":"in_progress","title":"虚构港口仪表盘","body":"当前已完成数据表，下一步制作异常趋势图。"}],
      "user_text": "继续‘虚构港口仪表盘’，请读取 Workspace 并告诉我下一步。",
      "expect": {
        "required_candidates": ["workspace:harbor"],
