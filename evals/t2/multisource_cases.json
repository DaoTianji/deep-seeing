        "required_uses": ["workspace:harbor"],
        "answer_must_contain": ["异常趋势图"]
      }
    },
    {
      "id": "MSI1",
      "category": "intent_plan",
      "description": "未来安排从 Intent 读取，不能说成已发生。",
      "intents": [{"key":"smoke","kind":"one_shot","title":"虚构周五冒烟检查","body":"周五发布前运行冒烟检查。"}],
      "user_text": "核对‘虚构周五冒烟检查’这个未来约定。读取 Intent 后告诉我它是否已经完成。",
      "expect": {
        "required_candidates": ["intent:smoke"],
        "required_reads": ["intent:smoke"],
        "required_uses": ["intent:smoke"],
        "answer_must_contain": ["不能确认"],
        "answer_must_not_contain": ["已经完成"]
      }
