        "answer_must_contain": ["42"]
      }
    },
    {
      "id": "MSB1",
      "category": "bond_baseline",
      "description": "完整 Bond 作为自动背景参与回答，不需搜索或读取。",
      "bond": [{"key":"style","slot":"interaction","claim":"讨论技术方案时先给结论，再解释理由。"}],
      "user_text": "按你对我的长期了解，用一句话说明你会怎样跟我讨论技术方案。",
      "expect": {
        "forbidden_reads": ["scene_norm","workspace","intent","proposal","episode"],
        "forbidden_uses": ["scene_norm","workspace","intent","proposal","episode"],
        "answer_must_contain": ["先给结论"]
      }
