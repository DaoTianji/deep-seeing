    {
      "id": "MSR1",
      "category": "plan_is_not_event",
      "description": "Intent 的 active 状态不能被误写为任务已执行。",
      "intents": [{"key":"backup","kind":"one_shot","title":"虚构月末备份","body":"月末计划备份归档库。"}],
      "user_text": "读取‘虚构月末备份’ Intent。它能证明备份已经发生了吗？",
      "expect": {
        "required_reads": ["intent:backup"],
        "required_uses": ["intent:backup"],
