      "intents": [{"key":"window","kind":"one_shot","title":"虚构迁移窗口","body":"计划周六凌晨执行第二批迁移。"}],
      "episodes": [{"key":"lesson","kind":"event","content":"第一批虚构海燕迁移曾因未校验回滚脚本而延迟。","why":"虚构历史教训"}],
      "user_text": "为‘虚构海燕迁移’安排下一步：读取当前项目、未来窗口，并搜索第一批的历史教训后回答。",
      "expect": {
        "required_reads": ["workspace:migration","intent:window","episode:lesson"],
        "required_uses": ["workspace:migration","intent:window","episode:lesson"],
        "answer_must_contain": ["回滚脚本","周六"]
      }
