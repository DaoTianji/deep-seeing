      "proposals": [{"key":"night","field":"baseline","text":"对方可能每天凌晨工作。","rationale":"一次虚构观察","hypothesis":"H1"}],
      "user_text": "读取关于作息的待确认 Proposal。你能断言我每天凌晨工作吗？",
      "expect": {
        "required_reads": ["proposal:night"],
