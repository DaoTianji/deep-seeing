      "user_text": "我们现在要做‘虚构发布复盘’，请查找并读取适用的场景规范，再告诉我第一步。",
      "expect": {
        "required_candidates": ["scene_norm:release"],
        "required_reads": ["scene_norm:release"],
        "required_uses": ["scene_norm:release"],
        "answer_must_contain": ["影响范围"]
      }
