    {
      "id": "TCI1",
      "category": "explicit_intent",
      "description": "明确核对未来约定时读取 Intent 并公开 check 结论。",
      "intents": [
        {"key": "target", "kind": "one_shot", "title": "虚构发布前检查", "body": "发布前必须检查回滚开关。"},
        {"key": "other", "kind": "one_shot", "title": "虚构植物浇水", "body": "周五给植物浇水。"}
