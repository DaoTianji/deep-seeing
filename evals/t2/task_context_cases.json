          "expect": {"required_workspace_keys": ["project"], "required_intent_keys": ["reminder"], "focus_workspace_key": "project", "focus_intent_key": "reminder", "focus_action": "continue", "focus_certainty": "clear", "needs_user_confirmation": false, "forbid_episode_search": true}
