      ]
    },
    {
      "id": "TCWI1",
      "category": "workspace_and_intent",
      "description": "项目和约定同时实质相关时读取二者并公开联合焦点。",
      "workspaces": [
        {"key": "project", "type": "project", "status": "in_progress", "title": "虚构灯塔发布", "body": "发布步骤第一项是运行离线检查。"}
