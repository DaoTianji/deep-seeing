      "category": "explicit_workspace",
      "description": "明确延续项目时读取正文并公开选择焦点。",
      "workspaces": [
        {"key": "target", "type": "project", "status": "in_progress", "title": "虚构任务处境建模", "body": "已完成薄快照，下一步是验证多轮焦点保持。"},
        {"key": "other", "type": "project", "status": "in_progress", "title": "虚构植物观察", "body": "下一步是记录叶片颜色。"}
