        {
          "user_text": "那就开始吧。请根据当前项目资料告诉我第一步。",
          "expect": {"snapshot_focus_workspace_key": "target", "required_workspace_keys": ["target"], "focus_workspace_key": "target", "focus_action": "continue", "focus_certainty": "clear", "needs_user_confirmation": false, "forbid_episode_search": true}
        }
      ]
    },
