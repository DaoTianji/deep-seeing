          "user_text": "继续‘虚构任务处境建模’项目。请先读取对应 Workspace，再告诉我下一步。",
          "expect": {"required_workspace_keys": ["target"], "focus_workspace_key": "target", "focus_action": "continue", "focus_certainty": "clear", "needs_user_confirmation": false, "forbid_episode_search": true}
        }
      ]
    },
    {
