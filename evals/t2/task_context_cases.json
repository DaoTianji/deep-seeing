        {"key": "unrelated", "type": "project", "status": "in_progress", "title": "虚构植物称重项目", "body": "下一步是给第二组植物称重。"}
      ],
      "turns": [
        {
          "user_text": "计算 17 乘以 23，只给结果。",
          "expect": {"forbid_context_expansion": true, "forbid_focus_declaration": true, "forbid_episode_search": true}
        }
      ]
    },
    {
