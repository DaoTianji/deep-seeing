          "expect": {"snapshot_focus_workspace_key": "alpha", "required_workspace_keys": ["beta"], "focus_workspace_key": "beta", "focus_action": "switch", "focus_certainty": "clear", "needs_user_confirmation": false, "forbid_episode_search": true}
        }
