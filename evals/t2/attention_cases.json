        {
          "user_text": "中间只回答 8 乘 7；不要改变刚才的项目焦点。",
          "expect": {
            "forbidden_tools": ["read_workspace","manage_attention"],
            "required_attention": {"workspace:aurora":"center"},
            "semantic_rules": ["回答 56，不展开项目正文。"]
          }
        },
        {
          "user_text": "回到核心项目，读取后告诉我刚才的下一步是什么。",
          "expect": {
            "required_reads": ["workspace:aurora"],
            "required_uses": ["workspace:aurora"],
            "required_attention": {"workspace:aurora":"center"},
            "semantic_rules": ["恢复虚构极光温室并回答校准湿度阈值。"]
          }
        }
      ]
