          "expect": {
            "required_tools": ["manage_attention"],
            "required_reads": ["workspace:aurora"],
            "required_uses": ["workspace:aurora"],
            "required_attention": {"workspace:aurora":"center"},
            "semantic_rules": ["下一步是校准湿度阈值。"]
          }
