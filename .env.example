# 洋葱内部 AI 网关（OpenAI-compatible）
# 把 OPENAI_API_KEY 换成你自己的网关 key
OPENAI_API_KEY=
OPENAI_BASE_URL=https://ops-ai-gateway.yc345.tv/v1
OPENAI_MODEL=gpt-5.6-sol

# Neo4j（Browser: http://host:7474/browser/ ；程序用 Bolt）
NEO4J_URI=bolt://118.145.226.253:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Redis（短期记忆 / 会话）
REDIS_ADDR=118.145.226.253:26739
REDIS_PASSWORD=
REDIS_DB=0
REDIS_STM_TTL_SEC=86400

# LTM Episode 目录（默认 data/memory/episodes）
LTM_EPISODE_DIR=

# Bond 提案队列（默认 data/memory/proposals）
LTM_PROPOSAL_DIR=

# Mutation Ledger（默认 data/memory/mutations）
LTM_MUTATION_DIR=

# Turn Trace（默认 data/memory/traces）
LTM_TRACE_DIR=

# LTM Graph（Neo4j）：凭证齐全默认开启；设 0/false 强制关闭
LTM_GRAPH=

# 内嵌谈话室监听地址（默认仅本机）
ROOM_ADDR=127.0.0.1:8787

# Soul / Origin（默认 seed/SOUL.md 与 seed/origin/）
SOUL_PATH=
ORIGIN_DIR=
# 强制再次注入 Origin Introduction（调试用）
FORCE_ORIGIN=
# first_boot 标记目录（默认 data/memory/state）
LTM_STATE_DIR=

# STM / Compaction
STM_MAX_MESSAGES=100
COMPACT_MAX_TOKENS=24000
COMPACT_MAX_MESSAGES=32
COMPACT_MIN_TAIL=8
COMPACT_TRIGGER_RATIO=0.8
